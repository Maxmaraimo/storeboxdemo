{% extends "base.html" %}

{% block title %}{{ t.page_title|default:"StoreBox — 15 daqiqada Telegram va Veb-do'koningizni ishga tushiring" }}{% endblock %}

{% block extra_head %}
<style>
    /* ============================================================ */
    /* STOREBOX $100K LUXURY APPLE STUDIO GLASSMORPHISM SYSTEM      */
    /* Direct 1:1 Match with User's Apple Pro Display XDR Photo     */
    /* ============================================================ */
    
    /* Background Ambient Studio Mesh */
    .apple-glass-canvas {
        background-color: #F8F9FA;
        background-image: 
            radial-gradient(at 15% 15%, rgba(139, 92, 246, 0.09) 0px, transparent 50%),
            radial-gradient(at 85% 20%, rgba(99, 102, 241, 0.08) 0px, transparent 50%),
            radial-gradient(at 50% 50%, rgba(248, 249, 250, 0.85) 0px, transparent 100%),
            radial-gradient(at 80% 80%, rgba(168, 85, 247, 0.06) 0px, transparent 50%);
    }
    .dark .apple-glass-canvas {
        background-color: #0A0A0C;
        background-image: 
            radial-gradient(at 15% 15%, rgba(139, 92, 246, 0.08) 0px, transparent 50%),
            radial-gradient(at 85% 20%, rgba(99, 102, 241, 0.08) 0px, transparent 50%),
            radial-gradient(at 50% 50%, rgba(16, 16, 20, 0.85) 0px, transparent 100%),
            radial-gradient(at 80% 80%, rgba(168, 85, 247, 0.05) 0px, transparent 50%);
    }

    /* Ultra White Glassmorphism Panel */
    .white-glass-card {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(28px) saturate(190%);
        -webkit-backdrop-filter: blur(28px);
        border: 1px solid rgba(255, 255, 255, 0.95);
        box-shadow: 
            0 20px 45px -10px rgba(15, 23, 42, 0.06),
            0 2px 8px 0 rgba(15, 23, 42, 0.02),
            inset 0 1px 1px 0 rgba(255, 255, 255, 0.9);
    }
    .dark .white-glass-card {
        background: rgba(24, 24, 28, 0.85);
        backdrop-filter: blur(28px) saturate(190%);
        -webkit-backdrop-filter: blur(28px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 
            0 25px 60px -15px rgba(0, 0, 0, 0.7),
            inset 0 1px 1px 0 rgba(255, 255, 255, 0.1);
    }

    /* 3D Apple Pro Display XDR Monitor Perspective & Stand */
    .monitor-perspective {
        perspective: 2200px;
    }
    .monitor-tilt {
        transform: rotateY(-6deg) rotateX(4deg);
        transform-style: preserve-3d;
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .monitor-tilt:hover {
        transform: rotateY(-1.5deg) rotateX(1deg);
    }

    /* Floating 3D Crystal Droplets / Spheres */
    .crystal-bubble {
        position: absolute;
        border-radius: 50%;
        background: radial-gradient(circle at 32% 28%, rgba(255, 255, 255, 0.98) 0%, rgba(255, 255, 255, 0.45) 30%, rgba(230, 235, 245, 0.2) 60%, rgba(139, 92, 246, 0.25) 100%);
        box-shadow: 
            inset -4px -4px 10px rgba(100, 116, 139, 0.2),
            inset 4px 4px 10px rgba(255, 255, 255, 0.95),
            0 14px 28px -6px rgba(15, 23, 42, 0.16),
            0 4px 8px -2px rgba(139, 92, 246, 0.15);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        pointer-events: none;
        z-index: 10;
    }
    .dark .crystal-bubble {
        background: radial-gradient(circle at 32% 28%, rgba(255, 255, 255, 0.45) 0%, rgba(255, 255, 255, 0.15) 30%, rgba(30, 27, 46, 0.4) 60%, rgba(139, 92, 246, 0.35) 100%);
        box-shadow: 
            inset -4px -4px 10px rgba(0, 0, 0, 0.6),
            inset 4px 4px 10px rgba(255, 255, 255, 0.25),
            0 14px 28px -6px rgba(0, 0, 0, 0.5);
    }

    /* Animations */
    @keyframes float-c1 {
        0%, 100% { transform: translate(0px, 0px) scale(1); }
        50% { transform: translate(6px, -14px) scale(1.03); }
    }
    @keyframes float-c2 {
        0%, 100% { transform: translate(0px, 0px) scale(1); }
        50% { transform: translate(-8px, -18px) scale(0.97); }
    }
    @keyframes float-c3 {
        0%, 100% { transform: translate(0px, 0px) rotate(0deg); }
        50% { transform: translate(10px, -10px) rotate(6deg); }
    }
    @keyframes pulse-ring-glow {
        0% { transform: scale(0.95); opacity: 0.85; }
        50% { transform: scale(1.4); opacity: 0.15; }
        100% { transform: scale(0.95); opacity: 0.85; }
    }
    @keyframes trajectory-flow {
        to { stroke-dashoffset: -100; }
    }
    @keyframes flying-pill-glide {
        0% { transform: translate(0, 0) scale(0.9); opacity: 0; }
        15% { opacity: 1; transform: translate(25px, -15px) scale(1); }
        85% { opacity: 1; transform: translate(180px, -50px) scale(1); }
        100% { transform: translate(210px, -60px) scale(0.9); opacity: 0; }
    }
    @keyframes flying-pill-glide-2 {
        0% { transform: translate(0, 0) scale(0.9); opacity: 0; }
        15% { opacity: 1; transform: translate(-20px, -10px) scale(1); }
        85% { opacity: 1; transform: translate(-140px, -45px) scale(1); }
        100% { transform: translate(-170px, -55px) scale(0.9); opacity: 0; }
    }
    @keyframes radar-sweep {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    .animate-crystal-1 { animation: float-c1 7s ease-in-out infinite; }
    .animate-crystal-2 { animation: float-c2 9s ease-in-out infinite; }
    .animate-crystal-3 { animation: float-c3 8s ease-in-out infinite; }
    .animate-pulse-ring { animation: pulse-ring-glow 2.5s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
    .animate-trajectory { stroke-dasharray: 5 5; animation: trajectory-flow 12s linear infinite; }
    .animate-flying-pill-1 { animation: flying-pill-glide 7s cubic-bezier(0.4, 0, 0.2, 1) infinite; }
    .animate-flying-pill-2 { animation: flying-pill-glide-2 8.5s cubic-bezier(0.4, 0, 0.2, 1) infinite 2s; }
    .animate-radar { animation: radar-sweep 8s linear infinite; transform-origin: center; }

    /* Range input styling for simulator */
    input[type=range] {
        -webkit-appearance: none;
        appearance: none;
        width: 100%;
        height: 8px;
        border-radius: 9999px;
        background: #E2E8F0;
        outline: none;
    }
    .dark input[type=range] {
        background: #27272A;
    }
    input[type=range]::-webkit-slider-thumb {
        -webkit-appearance: none;
        appearance: none;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: #7C3AED;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(124, 58, 237, 0.4);
        border: 2px solid #FFFFFF;
    }

    @keyframes marquee-scroll {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }
    .animate-marquee-track {
        display: flex;
        width: max-content;
        animation: marquee-scroll 32s linear infinite;
    }
    .animate-marquee-track:hover {
        animation-play-state: paused;
    }

    /* Quso.ai dot matrix background */
    .hero-dot-matrix {
        background-image: radial-gradient(rgba(124, 58, 237, 0.15) 1.2px, transparent 1.2px);
        background-size: 24px 24px;
    }
    .dark .hero-dot-matrix {
        background-image: radial-gradient(rgba(167, 139, 250, 0.18) 1.2px, transparent 1.2px);
        background-size: 24px 24px;
    }

    /* 3D floating tile hover and animation */
    @keyframes gentle-float {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-8px) rotate(1deg); }
    }
    @keyframes gentle-float-alt {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-10px) rotate(-1.5deg); }
    }
    .animate-gentle-float { animation: gentle-float 6s ease-in-out infinite; }
    .animate-gentle-float-alt { animation: gentle-float-alt 7s ease-in-out infinite 1.5s; }

    .tile-3d-shadow {
        box-shadow: 0 16px 32px -8px rgba(0, 0, 0, 0.12), 0 4px 12px -2px rgba(0, 0, 0, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.9);
    }
    .dark .tile-3d-shadow {
        box-shadow: 0 16px 32px -8px rgba(0, 0, 0, 0.6), 0 4px 12px -2px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.15);
    }

    /* ============================================================ */
    /* DYNAMIC ISLAND CAPSULES (Photo 1 Match: media_1789057382074) */
    /* ============================================================ */
    .dynamic-island-capsule {
        background: rgba(10, 10, 15, 0.94);
        backdrop-filter: blur(28px) saturate(220%);
        -webkit-backdrop-filter: blur(28px);
        border: 1px solid rgba(255, 255, 255, 0.16);
        box-shadow: 0 16px 36px -6px rgba(0, 0, 0, 0.65), 0 4px 12px rgba(0, 0, 0, 0.4), inset 0 1px 1px rgba(255, 255, 255, 0.3);
        color: #FFFFFF;
        border-radius: 9999px;
        transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .dynamic-island-capsule:hover {
        transform: scale(1.03) translateY(-2px);
        box-shadow: 0 20px 45px -8px rgba(0, 0, 0, 0.75), inset 0 1px 1.5px rgba(255, 255, 255, 0.4);
    }
    .dark .dynamic-island-capsule {
        background: rgba(8, 8, 12, 0.96);
        border: 1px solid rgba(255, 255, 255, 0.18);
        box-shadow: 0 20px 45px -8px rgba(0, 0, 0, 0.8), inset 0 1px 1px rgba(255, 255, 255, 0.2);
    }

    /* Soundwave bars animation inside Dynamic Island */
    @keyframes soundwave {
        0%, 100% { height: 4px; }
        50% { height: 15px; }
    }
    .soundwave-bar-1 { animation: soundwave 1.1s ease-in-out infinite; }
    .soundwave-bar-2 { animation: soundwave 0.8s ease-in-out infinite 0.2s; }
    .soundwave-bar-3 { animation: soundwave 1.3s ease-in-out infinite 0.4s; }
    .soundwave-bar-4 { animation: soundwave 0.9s ease-in-out infinite 0.1s; }

    /* ============================================================ */
    /* APPLE VISION PRO SPATIAL BOARD (Photo 2: media_1789057390240)*/
    /* ============================================================ */
    .vision-spatial-board {
        background: rgba(255, 255, 255, 0.65);
        backdrop-filter: blur(40px) saturate(210%);
        -webkit-backdrop-filter: blur(40px);
        border: 1.5px solid rgba(255, 255, 255, 0.85);
        box-shadow: 
            0 40px 100px -20px rgba(15, 23, 42, 0.18),
            0 10px 30px -5px rgba(124, 58, 237, 0.08),
            inset 0 1.5px 2px rgba(255, 255, 255, 0.95);
        border-radius: 36px;
    }
    .dark .vision-spatial-board {
        background: rgba(18, 18, 26, 0.72);
        backdrop-filter: blur(40px) saturate(210%);
        -webkit-backdrop-filter: blur(40px);
        border: 1.5px solid rgba(255, 255, 255, 0.14);
        box-shadow: 
            0 45px 110px -25px rgba(0, 0, 0, 0.8),
            0 10px 30px -5px rgba(124, 58, 237, 0.2),
            inset 0 1.5px 2px rgba(255, 255, 255, 0.18);
        border-radius: 36px;
    }

    /* Spatial Left Floating Dock */
    .vision-dock-pill {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(28px);
        -webkit-backdrop-filter: blur(28px);
        border: 1px solid rgba(255, 255, 255, 0.9);
        box-shadow: 0 12px 32px -4px rgba(0, 0, 0, 0.12), inset 0 1px 1px rgba(255, 255, 255, 0.9);
        border-radius: 9999px;
    }
    .dark .vision-dock-pill {
        background: rgba(24, 24, 32, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.14);
        box-shadow: 0 14px 36px -4px rgba(0, 0, 0, 0.6), inset 0 1px 1px rgba(255, 255, 255, 0.15);
    }

    /* Spatial Siri / Gemini Voice Orb */
    @keyframes siri-orb-rotate {
        0% { transform: scale(1) rotate(0deg); filter: hue-rotate(0deg); }
        50% { transform: scale(1.12) rotate(180deg); filter: hue-rotate(180deg); }
        100% { transform: scale(1) rotate(360deg); filter: hue-rotate(360deg); }
    }
    .animate-siri-orb {
        animation: siri-orb-rotate 10s linear infinite;
    }

    /* ============================================================ */
    /* LIQUID GLASS COMPONENTS (Photo 3 Match: media_1789057395710) */
    /* ============================================================ */
    .liquid-glass-card {
        background: rgba(255, 255, 255, 0.75);
        backdrop-filter: blur(28px);
        -webkit-backdrop-filter: blur(28px);
        border: 1px solid rgba(255, 255, 255, 0.9);
        box-shadow: 
            0 16px 36px -8px rgba(124, 58, 237, 0.08),
            inset 0 1.5px 2px rgba(255, 255, 255, 0.95),
            inset 0 -1px 2px rgba(0, 0, 0, 0.04);
        border-radius: 24px;
    }
    .dark .liquid-glass-card {
        background: rgba(24, 24, 34, 0.75);
        border: 1px solid rgba(255, 255, 255, 0.12);
        box-shadow: 
            0 18px 40px -10px rgba(0, 0, 0, 0.55),
            inset 0 1.5px 2px rgba(255, 255, 255, 0.18),
            inset 0 -1px 2px rgba(0, 0, 0, 0.2);
    }

    .liquid-glass-btn {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.95);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06), inset 0 1px 1.5px rgba(255, 255, 255, 0.95);
        transition: all 0.25s ease;
    }
    .liquid-glass-btn:hover {
        background: rgba(255, 255, 255, 0.95);
        box-shadow: 0 8px 24px rgba(124, 58, 237, 0.15), inset 0 1px 2px rgba(255, 255, 255, 1);
        transform: translateY(-1px);
    }
    .dark .liquid-glass-btn {
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.16);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4), inset 0 1px 1px rgba(255, 255, 255, 0.2);
    }
    .dark .liquid-glass-btn:hover {
        background: rgba(255, 255, 255, 0.14);
        box-shadow: 0 8px 24px rgba(124, 58, 237, 0.3), inset 0 1px 1px rgba(255, 255, 255, 0.3);
    }

    .liquid-glass-search {
        background: rgba(255, 255, 255, 0.65);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1.5px solid rgba(255, 255, 255, 0.9);
        box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.02), 0 4px 14px rgba(0, 0, 0, 0.04);
        border-radius: 9999px;
    }
    .dark .liquid-glass-search {
        background: rgba(20, 20, 28, 0.65);
        border: 1.5px solid rgba(255, 255, 255, 0.12);
        box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.3), 0 4px 14px rgba(0, 0, 0, 0.3);
    }

    /* ============================================================ */
    /* ROBO.UZ ANIMATIONS & KEYFRAMES (DIRECT REPRODUCTION)         */
    /* ============================================================ */
    @keyframes traffic {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
    .animate-traffic-spin {
        animation: traffic 14s linear infinite;
        transform-origin: center;
    }

    @keyframes sell {
        0% { transform: rotate(0deg); }
        50% { transform: rotate(4.5deg); }
        100% { transform: rotate(0deg); }
    }
    @keyframes sell-rev {
        0% { transform: rotate(0deg); }
        50% { transform: rotate(-4.5deg); }
        100% { transform: rotate(0deg); }
    }
    .animate-sell-tilt {
        animation: sell 3s ease-in-out infinite;
    }
    .animate-sell-tilt-rev {
        animation: sell-rev 3.2s ease-in-out infinite;
    }

    @keyframes island-float-1 {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-6px); }
    }
    @keyframes island-float-2 {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(6px); }
    }
    .animate-island-1 { animation: island-float-1 5s ease-in-out infinite; }
    .animate-island-2 { animation: island-float-2 6s ease-in-out infinite 1s; }

</style>
{% endblock %}

{% block content %}
<div class="apple-glass-canvas text-neutral-900 dark:text-neutral-100 min-h-screen relative overflow-hidden" 
     x-data="{ 
        billingPeriod: '12', 
        faqOpen: 1, 
        activeTab: 'channels',
        interactivePlatform: 'web',
        interactiveNiche: 'restaurant',
        orderVolume: 1200,
        consultationName: '',
        consultationPhone: '+998',
        consultationStore: '',
        consultationNiche: 'restaurant',
        consultationSubmitted: false,
        get grossRevenue() { return this.orderVolume * 180000; },
        get agencyLoss() { return 48000000; },
        get commissionSaved() { return Math.round(this.grossRevenue * 0.12); },
        get netProfit() { return Math.round(this.commissionSaved + 35000000); }
     }">

    <!-- Giant Ambient 3D Typographic Watermark (Directly from Photo 1) -->
    <div class="absolute top-20 left-1/2 -translate-x-1/2 text-[140px] sm:text-[220px] font-black text-black/[0.02] dark:text-white/[0.02] tracking-tighter select-none pointer-events-none -z-10 font-sans">
        Dashboard
    </div>

    <!-- 3D FLOATING CRYSTAL LIQUID SPHERES (Photo 2 Reference) -->
    <div class="crystal-bubble w-20 h-20 top-24 left-[4%] animate-crystal-1"></div>
    <div class="crystal-bubble w-12 h-12 top-52 left-[16%] animate-crystal-2"></div>
    <div class="crystal-bubble w-28 h-28 top-32 right-[5%] animate-crystal-3"></div>
    <div class="crystal-bubble w-14 h-14 top-96 right-[12%] animate-crystal-1"></div>

    <!-- ======================================================== -->
    <!-- 1. FLOATING APPLE GLASS NAVBAR                           -->
    <!-- ======================================================== -->
    <header class="sticky top-4 z-50 max-w-7xl mx-auto px-4 sm:px-6">
        <nav class="white-glass-card rounded-full px-5 py-3 flex items-center justify-between shadow-lg">
            
            <!-- Brand Logo -->
            <a href="/" class="flex items-center gap-2.5 group">
                <div class="w-8 h-8 rounded-xl bg-violet-600 text-white flex items-center justify-center font-black text-sm shadow-md group-hover:scale-105 transition-transform">
                    S
                </div>
                <div class="flex flex-col">
                    <span class="font-black text-sm tracking-tight text-neutral-900 dark:text-white flex items-center gap-1">
                        StoreBox
                        <span class="text-[9px] font-mono px-1.5 py-0.2 rounded-md bg-violet-100 dark:bg-violet-950/80 text-violet-700 dark:text-violet-300 font-bold">2.0</span>
                    </span>
                    <span class="text-[9px] text-neutral-400 font-medium">Apple Studio Ekotizim</span>
                </div>
            </a>

            <!-- Navigation Links -->
            <div class="hidden md:flex items-center gap-6 text-xs font-semibold text-neutral-600 dark:text-neutral-300">
                <a href="#imkoniyatlar" class="hover:text-violet-600 dark:hover:text-violet-400 transition-colors">{{ t.nav_features|default:"Imkoniyatlar" }}</a>
                <a href="#qanday-ishlaydi" class="hover:text-violet-600 dark:hover:text-violet-400 transition-colors">{{ t.nav_how|default:"Qanday ishlaydi?" }}</a>
                <a href="#kalkulyator" class="hover:text-violet-600 dark:hover:text-violet-400 transition-colors">Kalkulyator</a>
                <a href="#tariflar" class="hover:text-violet-600 dark:hover:text-violet-400 transition-colors">{{ t.nav_pricing|default:"Tariflar" }}</a>
                <a href="#mijozlar" class="hover:text-violet-600 dark:hover:text-violet-400 transition-colors">{{ t.showcase_badge|default:"Moslashuvchan dizayn" }}</a>
            </div>

            <!-- Right Controls -->
            <div class="flex items-center gap-3">
                <!-- Language Switcher -->
                <div class="relative" x-data="{ open: false }">
                    <button 
                        @click="open = !open" 
                        class="px-2.5 py-1.5 rounded-full text-xs font-bold text-neutral-600 dark:text-neutral-300 hover:bg-black/5 dark:hover:bg-white/10 transition-all flex items-center gap-1"
                    >
                        <span class="uppercase font-mono">{{ lang }}</span>
                        <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </button>
                    <div 
                        x-show="open" 
                        @click.away="open = false" 
                        x-cloak 
                        class="absolute right-0 mt-2 w-28 white-glass-card rounded-2xl py-1.5 shadow-xl border border-black/[0.06] dark:border-white/10 z-50 text-xs font-medium"
                    >
                        <a href="/lang/uz/?next={{ request.path }}" class="block px-3.5 py-1.5 hover:bg-violet-50 dark:hover:bg-violet-950/40 text-neutral-700 dark:text-neutral-200">O'zbekcha</a>
                        <a href="/lang/ru/?next={{ request.path }}" class="block px-3.5 py-1.5 hover:bg-violet-50 dark:hover:bg-violet-950/40 text-neutral-700 dark:text-neutral-200">Русский</a>
                        <a href="/lang/en/?next={{ request.path }}" class="block px-3.5 py-1.5 hover:bg-violet-50 dark:hover:bg-violet-950/40 text-neutral-700 dark:text-neutral-200">English</a>
                    </div>
                </div>

                <!-- Theme Toggle Button -->
                <button 
                    type="button" 
                    onclick="window.toggleTheme()" 
                    class="p-2 rounded-full text-neutral-600 dark:text-neutral-300 hover:bg-black/5 dark:hover:bg-white/10 transition-colors"
                    title="Mavzuni o'zgartirish"
                >
                    <svg class="w-4 h-4 hidden dark:block text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
                    <svg class="w-4 h-4 block dark:hidden text-neutral-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
                </button>

                <!-- Auth Buttons -->
                <a 
                    href="{{ app_site_url }}/dashboard/login/"
                    class="hidden sm:inline-flex text-xs font-bold text-neutral-700 dark:text-neutral-200 hover:text-violet-600 dark:hover:text-violet-400 px-3 py-1.5 transition-colors"
                >
                    {{ t.nav_login|default:"Kirish" }}
                </a>
                <a 
                    href="{{ app_site_url }}/dashboard/register/"
